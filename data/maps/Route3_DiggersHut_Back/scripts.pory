mapscripts Route3_DiggersHut_Back_MapScripts {
    MAP_SCRIPT_ON_LOAD: Route3_DiggersHut_Back_OnLoad
}

script Route3_DiggersHut_Back_OnLoad {
    // instead of doing the normal inverse stuff it was easier to make a C func due to the amount
    callnative(SetRoute3DiggersTunnelEncounters)

    if (!flag(FLAG_FOUGHT_DIGGERS_HUT_RICHARD)) {
        setvar(VAR_TEMP_A, 1)
        setobjectmovementtype(LOCALID_DIGGER, MOVEMENT_TYPE_FACE_DOWN)
    } else {
        setobjectmovementtype(LOCALID_DIGGER, MOVEMENT_TYPE_FACE_UP)
    }
}

script Route3_DiggersHut_Back_RichardFight {
    lock
    setvar(VAR_TEMP_A, 0)
    getobjectxy(LOCALID_PLAYER, CURRENT_POSITION, VAR_TEMP_1, VAR_TEMP_2)
    if (var(VAR_TEMP_1) == 4) {
        applymovement(LOCALID_PLAYER, moves(walk_right))
        waitmovement(0)
    }
    applymovement(LOCALID_PLAYER, moves(walk_up))
    playbgm(MUS_RG_ENCOUNTER_RIVAL, 0)
    waitmovement(0)
    msgbox(
        "I heard that there would be treasure,\nbut you want me to dig around in sand\lfor what, random items and Pokemon?\p"
        "Who do you think you are to tell me to\nrummage around in the dirt?\p"
        "I've got much better things to do than\nget my hands dirty!\p"
        "That's what Pokemon are for!"
    , MSGBOX_DEFAULT)
    applymovement(LOCALID_RICHARD_DIGGERSHUT, moves(walk_down))
    waitmovement(0)
    message("Get out of my way!")
    playse(SE_WALL_HIT)
    applymovement(LOCALID_PLAYER, moves(face_right lock_facing_direction walk_left unlock_facing_direction))
    applymovement(LOCALID_RICHARD_DIGGERSHUT, moves(walk_down*3))
    waitmovement(LOCALID_RICHARD_DIGGERSHUT)
    waitse
    delay(20)
    applymovement(LOCALID_PLAYER, moves(face_down))
    message("...")
    delay(30)
    applymovement(LOCALID_RICHARD_DIGGERSHUT, moves(face_up))
    waitmovement(0)
    message("Wait a minute...\pIt's you! The one from Horizon Port!\pHaha it's my lucky day!\nI'll take this frustration out on you!")
    waitmessage
    waitbuttonpress
    closemessage
    applymovement(LOCALID_RICHARD_DIGGERSHUT, moves(walk_fast_left, walk_fast_up))
    waitmovement(0)
    savebgm(MUS_RG_RIVAL_EXIT)
    setflag(FLAG_NO_WHITEOUT)

    // 1 - 0
    if (defeated(TRAINER_HORIZON_PORT_RICHARD)) {
        trainerbattle_earlyrival(
            TRAINER_DIGGERS_HUT_RICHARD,
            0,
            "What? Not again!\nHow are you doing that!?", 
            "Looks like your luck ran out."
        )
        
        // 2 - 0
        if (defeated(TRAINER_DIGGERS_HUT_RICHARD)) {
            msgbox(
                "I bet you think you're all that,\ndefeating me again.\p"
                "Next time I'll get some better Pokemon,\nthen we'll see who's stronger."
            , MSGBOX_DEFAULT)

        // 1 - 1
        } else {
            msgbox(
                "Last time was just a fluke, this time\nwas the real deal.\p"
                "Polish your skills for next time, it'll\nmake winning much more satisfying."
            , MSGBOX_DEFAULT)
        }
    
    // 0 - 1
    } else {
        trainerbattle_earlyrival(
            TRAINER_DIGGERS_HUT_RICHARD,
            0, 
            "What? That's not how it goes!",
            "Man, you suck at this."
        )
        
        // 1 - 1
        if (defeated(TRAINER_DIGGERS_HUT_RICHARD)) {
            msgbox(
                "Well, you've found some good Pokemon\nsince Horizon Port.\p"
                "Next time I'll get some better Pokemon,\nthen we'll see who's stronger.\p"
            , MSGBOX_DEFAULT)
        
        // 0 - 2
        } else {
            msgbox(
                "You spent all that time exploring for\nthat team?\p"
                "At this rate you don't even make a\ngood stepping stone."
            , MSGBOX_DEFAULT)
        }
    }
    msgbox(
        "Tell me your name, that way I'll at least\nknow what to carve on your gravestone\lafter you die of shame.\p"
        "...\p"
        "{PLAYER}? Pfft.\nStupid name for a stupid person.\p"
        "I'll see you again, '{PLAYER}'."
    , MSGBOX_AUTOCLOSE)
    clearflag(FLAG_NO_WHITEOUT)
    fadedefaultbgm
    applymovement(LOCALID_RICHARD_DIGGERSHUT, moves(walk_down*5 set_invisible))
    waitmovement(0)
    if (!defeated(TRAINER_DIGGERS_HUT_RICHARD)) { goto(EventScript_FieldWhiteOut) }
    applymovement(LOCALID_PLAYER, moves(walk_right walk_up*2))
    waitmovement(0)
    setflag(FLAG_FOUGHT_DIGGERS_HUT_RICHARD)
    msgbox(
        "Well, that was certainly an experience.\p"
        "Trainers aren't normally as...\nspirited as he is, thankfully.\p"
        "Thanks for putting him in his place, I'd\nhate to think he can act like that and\lget away with it.\p"
        "Oh right, digging!\p"
    , MSGBOX_DEFAULT)
    goto(Route3_DiggersHut_Back_Digger)
}

script Route3_DiggersHut_Back_Digger {
    if (!flag(FLAG_CAN_DIG_PILE)) {
        lock
        applymovement(LOCALID_DIGGER, moves(face_player))
        waitmovement(0)
        msgbox(
            "You look like someone who would love\nto get their hands dirty!\p"
            "That's probably why you came here in\nthe first place right?\p"
            "I'd be happy to give you a few pointers\non how to dig up things!\p"
            "It's real easy, and you might get some\ncool goodies from it too!\p"
            "Here, grab this shovel and we can get\nstarted...."
        , MSGBOX_AUTOCLOSE)
        fadescreenspeed(FADE_TO_BLACK, 2)
        delay(30)
        playse(SE_M_DIG)
        waitse
        playse(SE_M_DIG)
        waitse
        delay(30)
        playse(SE_M_DIG)
        waitse
        playse(SE_M_DIG)
        waitse
        delay(20)
        playse(SE_M_DIG)
        waitse
        delay(40)
        playse(MUS_OBTAIN_ITEM)
        setflag(FLAG_CAN_DIG_PILE)
        delay(10)
        fadescreen(FADE_FROM_BLACK)
        message("Whew! That was fun!\p")
        waitse
        waitmessage
        msgbox("I hope these skills help you out on your\nPokemon Adventure!", MSGBOX_AUTOCLOSE)
        applymovement(LOCALID_DIGGER, moves(face_up))
        waitmovement(0)
        releaseall
    }
    msgbox("Lairon makes for a great helper!\nHe does tend to eat a lot though...", MSGBOX_NPC)
}

script Route3_DiggersHut_Back_Hiker {
    trainerbattle_single(
        TRAINER_DIGGERS_HUT_HIKER, 
        "I've got sand in my boots!",
        "No! The sand is in my socks now!"
    )
    msgbox(format("I thought big boots would be a good idea, but not if they fill up with sand..."), MSGBOX_NPC)
}

script Route3_DiggersHut_Back_Maniac {
    trainerbattle_single(
        TRAINER_DIGGERS_HUT_MANIAC, 
        "You ever wondered what sand tastes\nlike?",
        "Blegh, sand everywhere."
    )
    msgbox("I'm not one to get my hands dirty,\nso I normally hire people to dig for me.", MSGBOX_NPC)
}

script Route3_DiggersHut_Back_BlackBelt {
    trainerbattle_single(
        TRAINER_DIGGERS_HUT_BLACKBELT, 
        "AH! DON'T SCARE ME LIKE THAT!",
        "JUMPSTARTS AREN'T GOOD FOR MY HEART!"
    )
    msgbox(format("I'm using my bare hands to dig through these rocks, but I think rock might be super-effective on bone."), MSGBOX_NPC)
}
