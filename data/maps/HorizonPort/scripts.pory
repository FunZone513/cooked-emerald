mapscripts HorizonPort_MapScripts {
    MAP_SCRIPT_ON_LOAD: HorizonPort_OnLoad
}

script HorizonPort_OnLoad {
    if (flag(FLAG_ITEM_HORIZON_PORT_4)) {
        setmetatile(32, 11, METATILE_General_SandPit_Center, FALSE)
    }

    if (!flag(FLAG_HIDE_HORIZON_PORT_RICHARD)) {
        setvar(VAR_TEMP_A, 1)
    } else {
        setflag(FLAG_TEMP_A)
    }
}

script HorizonPort_RichardBattle {
    setvar(VAR_TEMP_A, 0)
    setflag(FLAG_HIDE_HORIZON_PORT_RICHARD)
    getobjectxy(LOCALID_PLAYER, CURRENT_POSITION, VAR_TEMP_1, VAR_TEMP_2)
    if (var(VAR_TEMP_1) < 22) {
        while (var(VAR_TEMP_1) < 22) {
            applymovement(LOCALID_PLAYER, moves(walk_right))
            waitmovement(0)
            addvar(VAR_TEMP_1, 1)
        }
    } elif (var(VAR_TEMP_1 > 22)) {
        while (var(VAR_TEMP_1) > 22) {
            applymovement(LOCALID_PLAYER, moves(walk_left))
            waitmovement(0)
            subvar(VAR_TEMP_1, 1)
        }
    }
    applymovement(LOCALID_PLAYER, moves(face_down))
    waitmovement(0)
    special(SpawnCameraObject)
    applymovement(LOCALID_CAMERA, moves(walk_down))
    waitmovement(0)
    msgbox("You should've known better than to try\nand battle me while being so pathetic!\pGo Deino, finish her off!", MSGBOX_DEFAULT)
    playmoncry(SPECIES_DEINO, CRY_MODE_ENCOUNTER)
    applymovement(LOCALID_HORIZONPORT_DEINO, moves(jump_in_place_left*2))
    waitmoncry
    playse(SE_M_FLAME_WHEEL)
    waitse
    waitmovement(LOCALID_HORIZONPORT_DEINO)
    setobjectmovementtype(LOCALID_HORIZONPORT_DEINO, MOVEMENT_TYPE_JOG_IN_PLACE_LEFT)
    message("No! Ralts!")
    waitmessage
    playmoncry(SPECIES_RALTS, CRY_MODE_FAINT)
    applymovement(LOCALID_HORIZONPORT_RALTS, moves(face_up face_left face_down face_right))
    waitmovement(0)
    applymovement(LOCALID_HORIZONPORT_RALTS, moves(lock_facing_direction jump_left set_invisible))
    waitmovement(0)
    waitmoncry
    waitbuttonpress
    msgbox("You jerk!\pThat was so unnecessary!", MSGBOX_DEFAULT)
    msgbox("I beg to differ, people need to know\ntheir place.", MSGBOX_AUTOCLOSE)
    applymovement(LOCALID_HORIZONPORT_CRUSHGIRL, moves(walk_up*2))
    applymovement(LOCALID_CAMERA, moves(walk_up))
    waitmovement(LOCALID_HORIZONPORT_CRUSHGIRL)
    special(RemoveCameraObject)
    playse(SE_PIN)
    applymovement(LOCALID_PLAYER, moves(face_left))
    applymovement(LOCALID_HORIZONPORT_CRUSHGIRL, moves(emote_exclamation_mark delay_16 face_right))
    waitmovement(0)
    msgbox("Oh it's you, sorry you had to see that...\pI have to go to the Pokemon Centre,\nI hope we can catch up later...", MSGBOX_AUTOCLOSE)
    applymovement(LOCALID_HORIZONPORT_CRUSHGIRL, moves(walk_left walk_up*4))
    delay(20)
    applymovement(LOCALID_HORIZONPORT_DEINO, moves(face_right delay_16*2 jump_right set_invisible))
    waitmovement(LOCALID_HORIZONPORT_CRUSHGIRL)
    opendoor(20,28)
    playse(SE_SLIDING_DOOR)
    waitdooranim
    applymovement(LOCALID_HORIZONPORT_CRUSHGIRL, moves(walk_up set_invisible))
    waitmovement(LOCALID_HORIZONPORT_CRUSHGIRL)
    closedoor(20,28)
    playbgm(MUS_RG_ENCOUNTER_RIVAL, 0)
    applymovement(LOCALID_PLAYER, moves(face_down))
    applymovement(LOCALID_HORIZONPORT_RICHARD, moves(walk_left*2 walk_up*1))
    waitmovement(0)
    msgbox("And who are you supposed to be?\pNo, wait.\nI don't care.\pYou're just another NPC for me to win\nagainst.", MSGBOX_DEFAULT)
    savebgm(MUS_RG_RIVAL_EXIT)
    trainerbattle_no_intro(TRAINER_HORIZON_PORT_RICHARD, "Wait what?")
    msgbox(
        "That isn't how it was supposed to go.\p"
        "I must've been distracted after the\nfree win from before.\p"
        "It won't happen again, see you never."
    , MSGBOX_AUTOCLOSE)
    applymovement(LOCALID_HORIZONPORT_RICHARD, moves(walk_down*7 set_invisible))
    fadedefaultbgm
    waitmovement(0)
    releaseall
}

script HorizonPort_Sign_Yard {
    msgbox("Boats,\nA bouyant masterpiece", MSGBOX_SIGN)
}

script HorizonPort_Sign_Market {
    msgbox("Markets are now open!\nWe have wares if you have coin!", MSGBOX_SIGN)
}

script HorizonPort_Kid_Fire {
    lock
    faceplayer
    if (!defeated(TRAINER_HORIZON_PORT_FIRE)) {
        msgbox("He he he! You look like someone\nwho's up for a battle!", MSGBOX_YESNO)
        if (var(VAR_RESULT) == YES) {
            trainerbattle_single(
                TRAINER_HORIZON_PORT_FIRE, 
                "Yah!\nTake that!",
                "Wha- no!\nThat's not how it works!"  
            )
        } else { msgbox("Chicken!", MSGBOX_AUTOCLOSE) }
    } else {
        msgbox(format("I like being at the beach when the sun is out!"), MSGBOX_NPC)
    }
}

script HorizonPort_Kid_Water {
    lock
    faceplayer
    if (!defeated(TRAINER_HORIZON_PORT_WATER)) {
        msgbox("A challenger!\nDo you wish to do battle?", MSGBOX_YESNO)
        if (var(VAR_RESULT) == YES) {
            trainerbattle_single(
                TRAINER_HORIZON_PORT_WATER, 
                format("Being at the beach gives me power!"),
                "I got sand in my eye!\nThat didn't count!"  
            )
        } else { msgbox("Come back later then!", MSGBOX_AUTOCLOSE) }
    } else { msgbox(format("I love playing in the waves until I get all wrinkly!"), MSGBOX_NPC) }
}

script HorizonPort_Kid_Grass {
    lock
    faceplayer
    if (!defeated(TRAINER_HORIZON_PORT_GRASS)) {
        msgbox("You wanna have a battle?", MSGBOX_YESNO)
        if (var(VAR_RESULT) == YES) {
            trainerbattle_single(
                TRAINER_HORIZON_PORT_GRASS, 
                "I hope I win.",
                "Aw man."
            )
        } else { msgbox("All good.", MSGBOX_AUTOCLOSE) }
    } else { msgbox(format("I just wanna play my game, I'm hoping it doesn't get sand in it."), MSGBOX_NPC) }
}

script HorizonPort_Father {
    if (defeated(TRAINER_HORIZON_PORT_FIRE) && defeated(TRAINER_HORIZON_PORT_WATER) && defeated(TRAINER_HORIZON_PORT_GRASS)) {
        if (!flag(FLAG_BEAT_HORIZON_PORT_KIDS)) {
            msgbox(
                "I saw you battling with the little ones,\nI appreciate you playing with them.\p"
                "It gave me some time to relax for once,\nit's getting harder these days.\p"
                "And who knows when another one might\nbe on the way...\p"
                "Oh right,\nI have something for you as thanks."
            , MSGBOX_NPC)
            giveitem(ITEM_ORAN_BERRY, 1)
            setflag(FLAG_BEAT_HORIZON_PORT_KIDS)
            msgbox("I have an abundance of these\nlaying around...", MSGBOX_NPC)
        } else {
            msgbox(format("Thanks for keeping the kids company."), MSGBOX_NPC)
        }
    } else {
        msgbox(format("These little rascals really like battling, could you please keep them entertained so I can get some peace and quiet?"), MSGBOX_NPC)
    }
}

