mapscripts HorizonPort_MapScripts {
    MAP_SCRIPT_ON_LOAD: HorizonPort_OnLoad
}

script HorizonPort_OnLoad {
    //! debug
    if (!flag(FLAG_ADVENTURE_STARTED)) {
        call(Generic_DefaultSettings)
        setflag(FLAG_ADVENTURE_STARTED)
    }
}

script HorizonPort_Sign_Yard {
    msgbox("Boats,\nA bouyant masterpiece", MSGBOX_SIGN)
}

script HorizonPort_Sign_Market {
    msgbox("Markets are now open!\nWe have wares if you have coin!", MSGBOX_SIGN)
}

script HorizonPort_Kid_Fire {
    lockall
    faceplayer
    if (!defeated(TRAINER_HORIZON_PORT_FIRE)) {
        msgbox("He he he! You look like someone\nwho's up for a battle!", MSGBOX_YESNO)
        if (var(VAR_RESULT) == YES) {
            trainerbattle_single(
                TRAINER_HORIZON_PORT_FIRE, 
                "Yah!\nTake that!",
                "Wha- no!\nThat's not how it works!"  
            )
        } else { msgbox("Chicken!", MSGBOX_AUTOCLOSE) }
    } else {
        msgbox(format("I like being at the beach when the sun is out!"), MSGBOX_NPC)
    }
}

script HorizonPort_Kid_Water {
    lockall
    faceplayer
    if (!defeated(TRAINER_HORIZON_PORT_WATER)) {
        msgbox("A challenger!\nDo you wish to do battle?", MSGBOX_YESNO)
        if (var(VAR_RESULT) == YES) {
            trainerbattle_single(
                TRAINER_HORIZON_PORT_WATER, 
                format("Being at the beach gives me power!"),
                "I got sand in my eye!\nThat didn't count!"  
            )
        } else { msgbox("Come back later then!", MSGBOX_AUTOCLOSE) }
    } else { msgbox(format("I love playing in the waves until I get all wrinkly!"), MSGBOX_NPC) }
}

script HorizonPort_Kid_Grass {
    lockall
    faceplayer
    if (!defeated(TRAINER_HORIZON_PORT_GRASS)) {
        msgbox("You wanna have a battle?", MSGBOX_YESNO)
        if (var(VAR_RESULT) == YES) {
            trainerbattle_single(
                TRAINER_HORIZON_PORT_GRASS, 
                "I hope I win.",
                "Aw man."
            )
        } else { msgbox("All good.", MSGBOX_AUTOCLOSE) }
    } else { msgbox(format("I just wanna play my game, I'm hoping it doesn't get sand in it."), MSGBOX_NPC) }
}


script HorizonPort_OldMan {
    msgbox(format("This lighthouse was put in to make it safer for people to come to the island."), MSGBOX_NPC)
}

script HorizonPort_OldMan2 {
    msgbox(format("I sometimes come here and gaze out at the sea, thinking about what could have been."), MSGBOX_NPC)
}

script HorizonPort_Sailor {
    msgbox(format("We get a lot of travellers coming and going on boats 'round these parts."), MSGBOX_NPC)
}

script HorizonPort_Sailor2 {
    msgbox(format("Boats are pretty important for this city, so there are displays all over."), MSGBOX_NPC)
}

script HorizonPort_Boy {
    msgbox(format("The salt spray from the ocean makes my eyes crusty!"), MSGBOX_NPC)
}

script HorizonPort_OldWoman {
    msgbox(format("Huh? What do you want? Why don't you get back on your boat and go home!"), MSGBOX_NPC)
}

script HorizonPort_MarketPerson {
    msgbox(format("Items an aspiring trainer like you might need!"), MSGBOX_NPC)
    pokemart(HorizonPort_MarketShop)
    release
}

mart HorizonPort_MarketShop {
    ITEM_POKE_BALL
    ITEM_GREAT_BALL
    ITEM_POTION
    ITEM_SUPER_POTION
    ITEM_REPEL
}

script HorizonPort_MarketPerson2 {
    msgbox("Got problems? I've got solutions!", MSGBOX_NPC)
    pokemart(HorizonPort_MarketShop)
    release
}

mart HorizonPort_MarketShop2 {
    ITEM_ANTIDOTE
    ITEM_AWAKENING
    ITEM_BURN_HEAL
    ITEM_ICE_HEAL
    ITEM_PARALYZE_HEAL
}

