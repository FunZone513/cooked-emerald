// TODO: make this a quest? each new location is a subquest?
script HorizonPort_Gambler {
    if (!flag(FLAG_HORIZON_PORT_GAMBLER_SPOKEN)) {
        setobjectxy(LOCALID_HORIZONPORT_GAMBLER, 24, 25)
        lock
        playse(SE_WALL_HIT)
        playbgm(MUS_TRICK_HOUSE, FALSE)
        applymovement(LOCALID_PLAYER, moves(lock_facing_direction walk_left unlock_facing_direction))
        applymovement(LOCALID_HORIZONPORT_GAMBLER, moves(set_visible walk_left))
        waitmovement(0)
        msgbox(
            "Hello Hello!\p"
            "I bet you weren't expecting to see a\ndashing man such as myself back here!\p"
            "I like to hide around and give gifts to\nanyone who can find me!\p"
            "Since you've just started out on your\nadventure, how about I give you a\lnice and simple gift!\p"
            "Next time, we can even play a little\ngame for it!"
        , MSGBOX_DEFAULT)
        giveitem(ITEM_FULL_HEAL)
        msgbox("Well then, I shall hide once more and\nwait for you with bated breath!", MSGBOX_AUTOCLOSE)
        playse(SE_WARP_OUT)
        applymovement(LOCALID_HORIZONPORT_GAMBLER, moves(face_down disable_anim slide_up slide_up slide_up slide_up slide_up set_invisible))
        waitmovement(0)
        fadedefaultbgm
        setflag(FLAG_HORIZON_PORT_GAMBLER_SPOKEN)
        releaseall
    } else {
        msgbox("He's gone...", MSGBOX_SIGN)
    }    
}

script HorizonPort_Man {
    if (var(VAR_CURRENT_LEVEL_CAP) < 100) {
        msgbox("The Trainer Card is a neat bit of gear\ngiven by the adventure initiative.\pDid you know it tracks your current\nLevel Cap?", MSGBOX_NPC)
    } else {
        msgbox("The Trainer Card is a neat bit of gear\ngiven by the adventure initiative.", MSGBOX_NPC)
    }
}

