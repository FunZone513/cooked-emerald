    ITEM_ENERGY_POWDER
	ITEM_ENERGY_ROOT
	ITEM_HEAL_POWDER
	ITEM_REVIVAL_HERB
    ITEM_POWER_HERB
    ITEM_MIRROR_HERB
    ITEM_WHITE_HERB
    ITEM_MENTAL_HERB
}

script HorizonPort_MarketPerson2 {
    msgbox(format("I have some placeholder items!"), MSGBOX_NPC)
    pokemart(HorizonPort_MarketShop)
    release
}

