script HorizonPort_MarketPerson3 {
    msgbox(format("Welcome! Are you interested in some... Oh, actually I don't think you'd be interested in anything I sell."), MSGBOX_NPC)
}

script HorizonPort_MarketPerson4 {
    msgbox(format("There's always something of interest to be found at markets like these."), MSGBOX_NPC)
}

script HorizonPort_MarketPerson5 {
    msgbox(format("I'm just... huff... taking a break... hoo..."), MSGBOX_NPC)
}

//TODO: this guy
script HorizonPort_MarketPerson6 {
    msgbox(format("Come back when you're a little more cool."), MSGBOX_NPC)
}

script HorizonPort_Father {
    msgbox(format("These little rascals like battling as much as they like playing at the beach, so please keep them entertained so I can get some peace and quiet..."), MSGBOX_NPC)
}

script HorizonPort_Mother {
    msgbox(format("After three childred my husband has started having reservations, but I can be very convincing"), MSGBOX_NPC)
}


