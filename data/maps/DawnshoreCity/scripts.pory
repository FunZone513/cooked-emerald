mapscripts DawnshoreCity_MapScripts {
    MAP_SCRIPT_ON_LOAD: DawnshoreCity_OnLoad
}

script DawnshoreCity_OnLoad {
    if (flag(FLAG_ITEM_DAWNSHORE_CITY)) {
        setmetatile(15, 2, METATILE_General_SandPit_Center, FALSE)
    }

    if (flag(FLAG_ITEM_DAWNSHORE_CITY_2)) {
        setmetatile(21, 17, METATILE_General_SandPit_Center, FALSE)
    }

    if (flag(FLAG_ITEM_DAWNSHORE_CITY_3)) {
        setmetatile(8, 21, METATILE_General_SandPit_Center, FALSE)
    }

    if (flag(FLAG_ITEM_DAWNSHORE_CITY_4)) {
        setmetatile(42, 31, METATILE_General_SandPit_Center, FALSE)
    }

    if (flag(FLAG_CLEARED_DAWNSHORE_GYM)) {
        setmetatile(41, 14, METATILE_General_SandPit_Center, FALSE)
    }
}

script DawnshoreCity_GymBlocker_Guy {
    msgbox(
        "You trying to get to the Gym?\nSorry about this.\p"
        "I've come over from the Digger's Hut\non Route 3 to clear the way,\p"
        "but I think there's something hiding\nin the sand.\p"
        "I'm not a trainer, so I can't really do\nmuch about it...\p"
        "If you knew how to clear the sand then\nyou'd be able to get through no problem."
    , MSGBOX_NPC)
}

script DawnshoreCity_GymBlocker_Sand {
    if (!flag(FLAG_CAN_DIG_PILE)) {
        msgbox("It looks like there might be something\nburied here...", MSGBOX_AUTOCLOSE)
        end
    }

    getobjectxy(VAR_LAST_TALKED, CURRENT_POSITION, VAR_TEMP_1, VAR_TEMP_2)
    setmetatile(VAR_TEMP_1, VAR_TEMP_2, METATILE_General_SandPit_Center, FALSE)
    special(DrawWholeMapView)
    waitse
    playse(SE_PIN)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(emote_exclamation_mark))
    waitmovement(0)
    waitse
    getobjectfacingdirection(OBJ_EVENT_ID_PLAYER, VAR_TEMP_A)
    switch(var(VAR_TEMP_A)) {
        case DIR_NORTH: applymovement(LOCALID_DAWNSHORE_SANDMON, moves(set_visible jump_in_place_down))
        case DIR_SOUTH: applymovement(LOCALID_DAWNSHORE_SANDMON, moves(set_visible jump_in_place_up))
        case DIR_EAST:  applymovement(LOCALID_DAWNSHORE_SANDMON, moves(set_visible jump_in_place_left))
        case DIR_WEST:  applymovement(LOCALID_DAWNSHORE_SANDMON, moves(set_visible jump_in_place_right))
    }
    special(DrawWholeMapView) // is this necessary?
    playse(SE_LEDGE)
    waitmovement(0)
    waitse
    playmoncry(SPECIES_SANDYGAST, CRY_MODE_ENCOUNTER)
    waitmoncry
    setwildbattle(SPECIES_SANDYGAST, 12, ITEM_NONE, SPECIES_SANDYGAST, 12, ITEM_NONE)
    dowildbattle
    specialvar(VAR_RESULT, GetBattleOutcome)
    if (var(VAR_RESULT) == B_OUTCOME_WON || var(VAR_RESULT) == B_OUTCOME_CAUGHT || var(VAR_RESULT) == B_OUTCOME_DREW ) {
        setflag(FLAG_CLEARED_DAWNSHORE_GYM)
        removeobject(LOCALID_DAWNSHORE_SANDMON)
    } else {
        setmetatile(VAR_TEMP_1, VAR_TEMP_2, METATILE_General_SandPile, TRUE)
        special(DrawWholeMapView)
        applymovement(LOCALID_DAWNSHORE_SANDMON, moves(set_invisible))
        waitmovement(0)
    }
    releaseall
}

script DawnshoreCity_GymSign {
    msgbox("Dawnshore Gym:\nSun-kissed and Beach ready!", MSGBOX_SIGN)
}

script DawnshoreCity_CutterTree {
    if (flag(FLAG_CAN_USE_CUT)) {
        msgbox("You probably shouldn't start cutting up\ntheir garden!", MSGBOX_SIGN)
    } else {
        msgbox("This tree looks like it can be\nCUT down!", MSGBOX_SIGN)
    }
}

script DawnshoreCity_CutterSign {
    msgbox("Home of Mr. Auburn,\nTree cutting extraordinaire.", MSGBOX_SIGN)
}

script DawnshoreCity_Man {
    msgbox(format("My Loudred has been with me since I was a kid, it used to be so cute and quiet..."), MSGBOX_NPC)
}

script DawnshoreCity_Man2 {
    msgbox(format("They raised the Gym's spot onto a mound for some reason."), MSGBOX_NPC)
}

script DawnshoreCity_FatMan {
    msgbox(format("...do you hear a creaking sound?"), MSGBOX_NPC)
}

