mapscripts DawnshoreCity_MapScripts {
    MAP_SCRIPT_ON_LOAD: DawnshoreCity_OnLoad
}

script DawnshoreCity_OnLoad {
    if (flag(FLAG_ITEM_DAWNSHORE_CITY)) {
        setmetatile(15, 2, METATILE_General_SandPit_Center, FALSE)
    }

    if (flag(FLAG_ITEM_DAWNSHORE_CITY_2)) {
        setmetatile(21, 17, METATILE_General_SandPit_Center, FALSE)
    }

    if (flag(FLAG_ITEM_DAWNSHORE_CITY_3)) {
        setmetatile(8, 21, METATILE_General_SandPit_Center, FALSE)
    }
}

script DawnshoreCity_GymSign {
    msgbox("Dawnshore Gym:\nSun-kissed and Beach ready!", MSGBOX_SIGN)
}

script DawnshoreCity_CutterTree {
    if (flag(FLAG_CAN_USE_CUT)) {
        msgbox("You probably shouldn't start cutting up\ntheir garden!", MSGBOX_SIGN)
    } else {
        msgbox("This tree looks like it can be\nCUT down!", MSGBOX_SIGN)
    }
}

script DawnshoreCity_CutterSign {
    msgbox("Home of Mr. Auburn,\nTree cutting extraordinaire.", MSGBOX_SIGN)
}

script DawnshoreCity_Man {
    msgbox(format("My Loudred has been with me since I was a kid, it used to be so cute and quiet..."), MSGBOX_NPC)
}

script DawnshoreCity_Man2 {
    msgbox(format("They raised the Gym's spot onto a mound for some reason."), MSGBOX_NPC)
}

script DawnshoreCity_FatMan {
    msgbox(format("...do you hear a creaking sound?"), MSGBOX_NPC)
}

script DawnshoreCity_SwimmerM {
    msgbox(format("I would get up, but I think I've melted into the chair."), MSGBOX_NPC)
}

script DawnshoreCity_SwimmerF {
    msgbox(format("The sun here is great, I love getting my tan on!"), MSGBOX_NPC)
}

script DawnshoreCity_LittleGirl {
    msgbox(format("The sand makes little squeaky sounds when I walk around!"), MSGBOX_NPC)
}

script DawnshoreCity_Woman {
    msgbox(format("Sand makes for a good leg workout, too bad it gets all up in everywhere."), MSGBOX_NPC)
}