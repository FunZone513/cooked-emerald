mapscripts CrownForestNorth_MapScripts {
    MAP_SCRIPT_ON_LOAD: CrownForestNorth_OnLoad
}

script CrownForestNorth_OnLoad {
    if (var(VAR_GAME_PROGRESS) < GP_FOREST_JOSIE_ENCOUNTERED) {
        setvar(VAR_TEMP_A, 1)
    } else {
        setflag(FLAG_TEMP_A)
    }
}

script CrownForestNorth_JosieEncounter {
    setvar(VAR_TEMP_A, 0)
    waitse
    playse(SE_PIN)
    applymovement(LOCALID_CROWN_NORTH_JOSIE, moves(emote_exclamation_mark))
    waitmovement(LOCALID_CROWN_NORTH_JOSIE)
    getobjectxy(LOCALID_PLAYER, CURRENT_POSITION, VAR_TEMP_1, VAR_TEMP_2)
    switch(var(VAR_TEMP_2)) {
        case 8: applymovement(LOCALID_CROWN_NORTH_JOSIE, moves(walk_left walk_up*2 walk_left))
        case 9: applymovement(LOCALID_CROWN_NORTH_JOSIE, moves(walk_left walk_up walk_left))
        case 10: applymovement(LOCALID_CROWN_NORTH_JOSIE, moves(walk_left*2))
        case 11: applymovement(LOCALID_CROWN_NORTH_JOSIE, moves(walk_left walk_down walk_left))
    }
    waitmovement(LOCALID_CROWN_NORTH_JOSIE)
    if (flag(FLAG_JOSIE_KNOWS_PLAYER)) {
        msgbox(
            "{PLAYER}!\p"
            "I see you've made it past the trees on\nRoute 3!\p"
            "How did you go with the Gym battle?\nI hope it was fun for you too!"
        , MSGBOX_DEFAULT)
    } else {
        msgbox(
            "Oh hey!\p"
            "You made it through the Gym too!\nI hope Nami wasn't too harsh on you!\p"
            "Hey wait, I never caught your name!\nFellow trainers out on an adventure,\land I don't even know what to call you!\p"
            "My name is Josie!\nWhat about you?\p"
            "{PLAYER}!\nAlright!"
        , MSGBOX_DEFAULT)
    }

    msgbox("Say, I heard that Richard was hanging\naround the Digger's Hut on Route 3.", MSGBOX_DEFAULT)
    if (defeated(TRAINER_DIGGERS_HUT_RICHARD)) {
        msgbox(
            "You beat him in a battle?\nNice!\p"
            "Man I wish I could've seen it!\p"
            "That means you must be pretty good\nat battling right?"
        , MSGBOX_DEFAULT)
    } else {
        msgbox(
            "Didn't go too well huh?\nThat's unfortunate.\p"
            "I'm sure you'll get him next time though,\nyou'll probably run into him again.\p"
            "Oh! Tell you what!"
        , MSGBOX_DEFAULT)
    }

    if (flag(FLAG_JOSIE_KNOWS_PLAYER)) { msgbox("Pretty sure I owe you a battle!", MSGBOX_DEFAULT) }
    setflag(FLAG_JOSIE_KNOWS_PLAYER)
    msgbox(
        "We've met out on a route, that means we\nneed to have a battle of our own!\p"
        "I hope you're ready, cause I know I am!"
    , MSGBOX_AUTOCLOSE)
    trainerbattle_no_intro(
        TRAINER_CROWN_NORTH_JOSIE, 
        "Wow! You're pretty good!\nI'll have to train harder for next time!"
    )
    msgbox(
        "Well you sure know how to battle!\p"
        "Keep up this momentum, and don't let\nRichard pull ahead of you.\p"
        "I'll be off to heal now, we should\ndo this again!"
    , MSGBOX_AUTOCLOSE)
    if (var(VAR_TEMP_2) == 8) {
        applymovement(LOCALID_CROWN_NORTH_JOSIE, moves(walk_down))
    } else { applymovement(LOCALID_CROWN_NORTH_JOSIE, moves(walk_up)) }
    waitmovement(LOCALID_CROWN_NORTH_JOSIE)
    applymovement(LOCALID_CROWN_NORTH_JOSIE, moves(walk_left*9 set_invisible))
    waitmovement(0)
    setobjectxyperm(LOCALID_CROWN_NORTH_JOSIE, 0, 0)
    playse(SE_EXIT)
    waitse
    setflag(FLAG_TEMP_A)
    setvar(VAR_GAME_PROGRESS, GP_FOREST_JOSIE_ENCOUNTERED)
    call(Generic_UPDATE_LEVELCAP)
    releaseall
}

script CrownForestNorth_BugManiac {
    trainerbattle_single(
        TRAINER_CROWN_NORTH_BUG_MANIAC, 
        "Shh...\nDo you hear that?",
        "I was trying to listen!"
    )
    msgbox(format("I can hear something rustling about in the grass..."), MSGBOX_NPC)
}

script CrownForestNorth_Hiker {
    trainerbattle_single(
        TRAINER_CROWN_NORTH_HIKER, 
        "I'm getting soaked!",
        "No! My socks got wet!"
    )
    msgbox(format("I should've packed an umbrella..."), MSGBOX_NPC)
}

script CrownForestNorth_BlackBelt {
    trainerbattle_single(
        TRAINER_CROWN_NORTH_BLACKBELT, 
        "LET US COMMENCE BATTLE!",
        "THE BATTLE DIDN'T GO AS PLANNED!"
    )
    msgbox(format("How's it going?"), MSGBOX_NPC)
}

script CrownForestNorth_BattleGirl {
    trainerbattle_single(
        TRAINER_CROWN_NORTH_BATTLEGIRL, 
        "If I win you have to drop and give\nme 20!",
        "Suit yourself, more pushups for me!"
    )
    msgbox(format("Get a load of these guns!"), MSGBOX_NPC)
}

script CrownForestNorth_Parasol {
    trainerbattle_single(
        TRAINER_CROWN_NORTH_PARASOL, 
        "Am I the only person prepared?",
        "You may have won, but I'm still dry.\nSo who's the real winner?"
    )
    msgbox(format("I'd heard that it rains a lot in here, but it really does."), MSGBOX_NPC)
}

script CrownForestNorth_BirdKeeper {
    trainerbattle_single(
        TRAINER_CROWN_NORTH_BIRD_KEEPER, 
        "Wet wings can still fly!",
        "Help! Feathers full of water!"
    )
    msgbox(format("Flying types are good against all the bugs here."), MSGBOX_NPC)
}

script CrownForestNorth_Breeder {
    trainerbattle_single(
        TRAINER_CROWN_NORTH_BREEDER, 
        "I'm just out for a stroll, care to have\nsome fun?",
        "My babies need to expend their energy\nsomehow after all."
    )
    msgbox(format("Even if I lose, battling trainers is a good way to exercise."), MSGBOX_NPC)
}

script CrownForestNorth_AromaLady {
    trainerbattle_single(
        TRAINER_CROWN_NORTH_AROMA_LADY, 
        "I'm not really a fan of standing around\nin the rain.",
        "Oh dear..."
    )
    msgbox(format("At least the Rest Area stays dry."), MSGBOX_NPC)
}