mapscripts RestArea1_Indoor_MapScripts {
    MAP_SCRIPT_ON_LOAD: RestArea1_Indoor_OnLoad
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_GAME_PROGRESS, GP_HORIZON_PORT_RIVAL_ENCOUNTERED: RestArea1_Indoor_Josie
    ]
}

script RestArea1_Indoor_OnLoad {
    if (var(VAR_GAME_PROGRESS) >= GP_REST_AREA_1_ENCOUNTERED ) {
        setflag(FLAG_TEMP_A)
    }
}

script RestArea1_Indoor_Josie {
    lock
    setvar(VAR_GAME_PROGRESS, GP_REST_AREA_1_ENCOUNTERED)
    applymovement(LOCALID_RESTAREA1_JOSIE, moves(walk_right*3 face_down))
    waitmovement(0)
    playse(SE_PIN)
    applymovement(LOCALID_RESTAREA1_JOSIE, moves(emote_exclamation_mark))
    waitmovement(0)
    applymovement(LOCALID_RESTAREA1_JOSIE, moves(walk_down))
    waitse
    waitmovement(0)
    msgbox(
        "It's good to see you!\p"
        "I hope Richard didn't give you too much\ntrouble after I left.\p"
        "..."
    )
    if (defeated(TRAINER_HORIZON_PORT_RICHARD)) {
        msgbox("You beat him?\nNice!\pI bet that really showed him!\nI wish I could've seen it.")
    } else {
        msgbox("He got you too did he?\nThat sucks.\pI'm sure you'll get another chance,\nI'll be rooting for you when you do!")
    }
    msgbox(
        "Wait, I never got your name!\p"
        "This needs to be fixed!\p"
        "...\p{PLAYER}?\p"
        "Well, it's good to officially meet you\n{PLAYER}!\p"
        "My name's Josie!\p"
        "We should catch up for a Pokemon Battle\nsometime soon!\pI'd offer to do one here but..."
    )
    setflag(FLAG_JOSIE_KNOWS_PLAYER)
    closemessage
    applymovement(LOCALID_RESTAREA1_JOSIE, moves(face_up delay_16*5 face_down))
    waitmovement(0)
    msgbox(
        "We're not allowed to battle in the\nRest Areas, it's a safety rule.\p"
        "So we'll have to meet up somewhere else!\p"
        "I'll head out first {PLAYER},\nhope to see you soon!"
    )
    closemessage
    applymovement(LOCALID_PLAYER, moves(walk_left face_right))
    waitmovement(0)
    applymovement(LOCALID_RESTAREA1_JOSIE, moves(walk_down))
    waitmovement(0)
    playse(SE_EXIT)
    waitse
    applymovement(LOCALID_RESTAREA1_JOSIE, moves(set_invisible))
    waitmovement(0)
    releaseall
}

script RestArea1_Indoor_Nurse {
    msgbox(
        "Welcome to the Rest Area!\p"
        "Rest Areas are spots set up between\ntowns to give trainers some respite,\land they act as a place for mingling.\p"
        "Feel free to take a break in an empty\nroom, or talk with your fellow trainers!", 
    MSGBOX_NPC)
}

script RestArea1_Indoor_Woman {
    msgbox(format("I didn't really need to use the Rest Area, but sitting down on a chair sure is nice."), MSGBOX_NPC)
}

script RestArea1_Indoor_Hiker {
    msgbox(format("You takin' a break too lad?"), MSGBOX_NPC)
}

script RestArea1_Indoor_Maniac {
    msgbox(format("I'm washing up after eating, because that's the polite thing to do."), MSGBOX_NPC)
    applymovement(VAR_LAST_TALKED, moves(face_up))
    waitmovement(0)
    releaseall
}

script RestArea1_Indoor_Girl {
    msgbox("Have you been in the small bit of forest\nnearby yet?\pIt's pretty spooky in there!", MSGBOX_NPC)
}

script RestArea1_Indoor_RichBoy {
    msgbox(format("I'll have you know that I could afford to sleep in a 5 star hotel, I just thought I'd see how the lower class spends their time."), MSGBOX_NPC)
}

script RestArea1_Indoor_Man {
    msgbox(format("Do you mind?"), MSGBOX_NPC)
    applymovement(VAR_LAST_TALKED, moves(face_up))
    waitmovement(0)
    releaseall
}