script DawnshoreCity_CuttersHouse_Man {
    if (!flag(FLAG_BADGE01_GET)) {
        msgbox("Come back once you beat the gym", MSGBOX_NPC)
    } else {
        msgbox("congrats you can cut trees now.\nThis'll be an actual thing later", MSGBOX_NPC)
        setflag(FLAG_CAN_USE_CUT)
    }
}

