//MARK: Game Version
script Generic_InfoNPC {
    msgbox("Current Game Version is:\n- 0.0.1 -", MSGBOX_NPC)
}



//MARK: Default Settings
script Generic_DefaultSettings {
    setflag(FLAG_SYS_B_DASH)
    setflag(FLAG_SHARED_EXP)
    call(Generic_UPDATE_LEVELCAP)
    call(Generic_IncreaseExpGain)

    //! this is for testing
    givemon(SPECIES_BALTOY, 5)
    setflag(FLAG_SYS_POKEMON_GET)
    setflag(FLAG_SYS_QUEST_MENU_GET)
    setflag(FLAG_SYS_POKEDEX_GET)
    special(SetUnlockedPokedexFlags)
    //setflag(FLAG_RECEIVED_POKEDEX_FROM_BIRCH)
    //setflag(FLAG_NOCLIP)
    //!

    // % chance
    setvar(VAR_WILD_BATTLE_CHANCE, 15)
    
    releaseall
}

script Generic_IncreaseExpGain {
    //! this is 2.0x for playtesting purposes
    setvar(VAR_INCREASE_EXP_GAIN, 100)

    // % increase. EG: 20 = 1.2x experience. Set to 0 for no bonus.
    //setvar(VAR_INCREASE_EXP_GAIN, 50) 
}

//MARK: Level Cap
script Generic_GetBadgeCount {
    setvar(VAR_RESULT, 0)
    if (flag(FLAG_BADGE01_GET)) { addvar(VAR_RESULT, 1) }
    if (flag(FLAG_BADGE02_GET)) { addvar(VAR_RESULT, 1) }
    if (flag(FLAG_BADGE03_GET)) { addvar(VAR_RESULT, 1) }
    if (flag(FLAG_BADGE04_GET)) { addvar(VAR_RESULT, 1) }
    if (flag(FLAG_BADGE05_GET)) { addvar(VAR_RESULT, 1) }
    if (flag(FLAG_BADGE06_GET)) { addvar(VAR_RESULT, 1) }
    if (flag(FLAG_BADGE07_GET)) { addvar(VAR_RESULT, 1) }
    if (flag(FLAG_BADGE08_GET)) { addvar(VAR_RESULT, 1) }
    return
}

script Generic_UPDATE_LEVELCAP {
    call(Generic_GetBadgeCount)
    
    // this is how many badges you have, so the levelcap is offset by one (ie; 0 = first gym = 15)
    switch(var(VAR_RESULT)) {
        case 0: setvar(VAR_CURRENT_LEVEL_CAP, 15) break
        case 1: setvar(VAR_CURRENT_LEVEL_CAP, 22) break
        case 2: setvar(VAR_CURRENT_LEVEL_CAP, 30) break
        case 3: setvar(VAR_CURRENT_LEVEL_CAP, 100) break
        case 4: setvar(VAR_CURRENT_LEVEL_CAP, 100) break
        case 5: setvar(VAR_CURRENT_LEVEL_CAP, 100) break
        case 6: setvar(VAR_CURRENT_LEVEL_CAP, 100) break
        case 7: setvar(VAR_CURRENT_LEVEL_CAP, 100) break
        case 8: setvar(VAR_CURRENT_LEVEL_CAP, 100) break
    }
    return
}

script Generic_GYM_LEVEL_GUIDE {
    lockall
    if (var(VAR_CURRENT_LEVEL_CAP) != 100) {
        buffernumberstring(STR_VAR_1, VAR_CURRENT_LEVEL_CAP)
        msgbox("Current Level Cap:\n{STR_VAR_1}", MSGBOX_SIGN)
    } else {
        call(Generic_UPDATE_LEVELCAP)
        buffernumberstring(STR_VAR_1, VAR_CURRENT_LEVEL_CAP)
        msgbox("Current Level Cap:\n{STR_VAR_1}", MSGBOX_SIGN)
        setvar(VAR_CURRENT_LEVEL_CAP, 100)
    }
    releaseall
}

//MARK: Generic PKMN
script Generic_POKEMON_INTERACT {
    lock
    applymovement(VAR_LAST_TALKED, moves(face_player))
    waitmovement(0)
    callnative(GetInteractedPokemon)
    if (flag(FLAG_SYS_POKEDEX_GET)) {setseenmon(VAR_0x8004)}
    playmoncry(VAR_0x8004, CRY_MODE_NORMAL)
    
    random(5)
    switch(var(VAR_RESULT)) {
        case 0: message("?")
        case 1: message("?")
        case 2: message("!")
        case 3: message("...")
        case 4: message("!?")
        default: message("?")
    }
    
    waitmessage
    //waitmoncry
    waitbuttonpress
    releaseall
}


//MARK: Sand / Ash Piles

// Finding a hidden item
script Common_EventScript_FindItemSand {
    getobjectxy(VAR_LAST_TALKED, CURRENT_POSITION, VAR_TEMP_1, VAR_TEMP_2)
    setmetatile(VAR_TEMP_1, VAR_TEMP_2, METATILE_General_SandPit_Center, FALSE)
    callnative(GetItemBallIdAndAmountFromTemplate)
	finditem(VAR_RESULT, VAR_0x8009)
}

// Setting / Finding hidden Pokemon
// VAR_TEMP_0 = id, VAR_TEMP_1 = x, VAR_TEMP_2 = y
script Generic_SetPokemonSandPile {
    setmetatile(VAR_TEMP_1, VAR_TEMP_2, METATILE_General_SandPile, TRUE)
    setobjectxy(VAR_TEMP_0, VAR_TEMP_1, VAR_TEMP_2)
    applymovement(VAR_TEMP_0, moves(face_down set_invisible))
    waitmovement(0)
}

// Set the species to VAR_0x8008 and level to VAR_0x800B
script Common_EventScript_FindPokemonSand {
    getobjectxy(VAR_LAST_TALKED, CURRENT_POSITION, VAR_TEMP_1, VAR_TEMP_2)
    setmetatile(VAR_TEMP_1, VAR_TEMP_2, METATILE_General_SandPit_Center, FALSE)
    applymovement(VAR_LAST_TALKED, moves(set_visible jump_in_place_down delay_16))
    waitmovement(0)
    playse(SE_PIN)
    applymovement(VAR_LAST_TALKED, moves(emote_exclamation_mark delay_16 face_player))
    waitmovement(0)
    waitse
    callnative(GetInteractedPokemon)
    playmoncry(VAR_0x8008, CRY_MODE_ENCOUNTER)
    setwildbattle(VAR_0x800A, VAR_0x800B)
    waitmoncry
    dowildbattle
    applymovement(VAR_LAST_TALKED, moves(set_invisible))
    waitmovement(0)
    setobjectxyperm(VAR_LAST_TALKED, 0, 0)
}

script Common_EventScript_FindItemAsh {
    getobjectxy(VAR_LAST_TALKED, CURRENT_POSITION, VAR_TEMP_1, VAR_TEMP_2)
    setmetatile(VAR_TEMP_1, VAR_TEMP_2, METATILE_Fallarbor_AshField, FALSE)
    callnative(GetItemBallIdAndAmountFromTemplate)
	finditem(VAR_RESULT, VAR_0x8009)
}


//MARK: Pokemart
script Generic_POKEMART {
    lock
    faceplayer
    message("Welcome!\pHow may I serve you?")
    waitmessage
    call(Generic_GetBadgeCount)
    switch(var(VAR_RESULT)) {
        case 0:
            pokemart(GenericPokeMart_1)
            break

        case 1:
            pokemart(GenericPokeMart_2)
            break
        
        case 2:
            pokemart(GenericPokeMart_3)
            break

        case 3:
            pokemart(GenericPokeMart_4)
            break

        case 4:
        case 5:
        case 6:
        case 7:
        case 8:
        default:
            pokemart(GenericPokeMart_5)
    }
    msgbox("Please come again!", MSGBOX_DEFAULT)
    release
}

