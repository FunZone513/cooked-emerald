//MARK: Default Settings
script Generic_DefaultSettings {
    setflag(FLAG_SHARED_EXP)
    call(Generic_UPDATE_LEVELCAP)
    
    // % increase. EG: 20 = 1.2x experience. Set to 0 for no bonus.
    setvar(VAR_INCREASE_EXP_GAIN, 20)

    // % chance
    setvar(VAR_WILD_BATTLE_CHANCE, 15)

    releaseall
}

//MARK: Level Cap
// simple count of badges
script Generic_GetBadgeCount {
    setvar(VAR_RESULT, 0)
    if (flag(FLAG_BADGE01_GET)) { addvar(VAR_RESULT, 1) }
    if (flag(FLAG_BADGE02_GET)) { addvar(VAR_RESULT, 1) }
    if (flag(FLAG_BADGE03_GET)) { addvar(VAR_RESULT, 1) }
    if (flag(FLAG_BADGE04_GET)) { addvar(VAR_RESULT, 1) }
    if (flag(FLAG_BADGE05_GET)) { addvar(VAR_RESULT, 1) }
    if (flag(FLAG_BADGE06_GET)) { addvar(VAR_RESULT, 1) }
    if (flag(FLAG_BADGE07_GET)) { addvar(VAR_RESULT, 1) }
    if (flag(FLAG_BADGE08_GET)) { addvar(VAR_RESULT, 1) }
    return
}

// goes through each "boss battle"'s thing (GP_VAR or FLAG) and updates the level cap
script Generic_UPDATE_LEVELCAP {
    // started the game -> nothing done yet, level 5
    setvar(VAR_CURRENT_LEVEL_CAP, 5)

    // fought Richard in horizon city (set to Nami's ace)
    if (var(VAR_GAME_PROGRESS) >= GP_HORIZON_PORT_RIVAL_ENCOUNTERED) { 
        setvar(VAR_CURRENT_LEVEL_CAP, 15) 
    }
    
    // beat the first gym (Set to Josie's Ace)
    if (flag(FLAG_BADGE01_GET)) { 
        setvar(VAR_CURRENT_LEVEL_CAP, 18) 
    }
    
    // fought Josie after first gym
    if (var(VAR_GAME_PROGRESS) >= GP_FOREST_JOSIE_ENCOUNTERED) { 
        setvar(VAR_CURRENT_LEVEL_CAP, 100) // idk 
    }
    
    return
}

script Generic_GYM_LEVEL_GUIDE {
    lockall
    if (var(VAR_CURRENT_LEVEL_CAP) != 100) {
        buffernumberstring(STR_VAR_1, VAR_CURRENT_LEVEL_CAP)
        msgbox("Current Level Cap:\n{STR_VAR_1}", MSGBOX_SIGN)
    } else {
        call(Generic_UPDATE_LEVELCAP)
        buffernumberstring(STR_VAR_1, VAR_CURRENT_LEVEL_CAP)
        msgbox("Current Level Cap:\n{STR_VAR_1}", MSGBOX_SIGN)
        setvar(VAR_CURRENT_LEVEL_CAP, 100)
    }
    releaseall
}

//MARK: Generic PKMN
script Generic_POKEMON_INTERACT {
    lock
    // faceplayer macro is broken for asym mons
    getobjectfacingdirection(OBJ_EVENT_ID_PLAYER, VAR_TEMP_A)
    switch(var(VAR_TEMP_A)) {
        case DIR_NORTH: turnobject(VAR_LAST_TALKED, DIR_SOUTH)
        case DIR_SOUTH: turnobject(VAR_LAST_TALKED, DIR_NORTH)
        case DIR_EAST:  turnobject(VAR_LAST_TALKED, DIR_WEST)
        case DIR_WEST:  turnobject(VAR_LAST_TALKED, DIR_EAST)
    }

    callnative(GetInteractedPokemon)
    waitse
    if (flag(FLAG_SYS_POKEDEX_GET)) {setseenmon(VAR_0x8004)}
    playmoncry(VAR_0x8004, CRY_MODE_NORMAL)
    
    random(6)
    switch(var(VAR_RESULT)) {
        case 0: applymovement(VAR_LAST_TALKED, moves(emote_question_mark))
        case 1: applymovement(VAR_LAST_TALKED, moves(emote_question_mark))
        case 2: applymovement(VAR_LAST_TALKED, moves(emote_question_mark))
        case 3: applymovement(VAR_LAST_TALKED, moves(emote_exclamation_mark))
        case 4: applymovement(VAR_LAST_TALKED, moves(emote_exclamation_mark))
        case 5: applymovement(VAR_LAST_TALKED, moves(emote_double_exclamation_mark))
    }
    waitmovement(VAR_LAST_TALKED)
    waitmoncry
    release
}

//MARK: Hidden Mons 
//     (and item piles)

script EventScript_SpecialWildEncounter {
    if (!flag(FLAG_CAN_DIG_PILE)) {
        msgbox("It looks like there might be something\nburied here...", MSGBOX_AUTOCLOSE)
        end
    }

    special(SetupSpecialWildEncounter)

    if (var(VAR_RESULT) != SPECIES_NONE) {
        waitse
        playse(SE_PIN)
        applymovement(OBJ_EVENT_ID_PLAYER, moves(emote_exclamation_mark))
        waitmovement(0)
        waitse
        getobjectfacingdirection(OBJ_EVENT_ID_PLAYER, VAR_TEMP_A)
        switch(var(VAR_TEMP_A)) {
            case DIR_NORTH: applymovement(LOCALID_SPECIAL_ENCOUNTER_MON, moves(set_visible jump_in_place_down))
            case DIR_SOUTH: applymovement(LOCALID_SPECIAL_ENCOUNTER_MON, moves(set_visible jump_in_place_up))
            case DIR_EAST:  applymovement(LOCALID_SPECIAL_ENCOUNTER_MON, moves(set_visible jump_in_place_left))
            case DIR_WEST:  applymovement(LOCALID_SPECIAL_ENCOUNTER_MON, moves(set_visible jump_in_place_right))
        }
        special(DrawWholeMapView)
        playse(SE_LEDGE)
        waitmovement(0)
        waitse
        playmoncry(VAR_RESULT, CRY_MODE_ENCOUNTER)
        waitmoncry
        special(DoSpecialWildEncounter)
        removeobject(LOCALID_SPECIAL_ENCOUNTER_MON)
    } else {
        special(DrawWholeMapView)
    }
}

// Finding a hidden item
script Common_EventScript_FindItemSand {
    if (!flag(FLAG_CAN_DIG_PILE)) {
        msgbox("It looks like there might be something\nburied here...", MSGBOX_AUTOCLOSE)
        end
    }

    getobjectxy(VAR_LAST_TALKED, CURRENT_POSITION, VAR_TEMP_1, VAR_TEMP_2)
    setmetatile(VAR_TEMP_1, VAR_TEMP_2, METATILE_General_SandPit_Center, FALSE)
    special(DrawWholeMapView)
    applymovement(VAR_LAST_TALKED, moves(set_visible jump_in_place_down delay_8))
    waitmovement(0)
    callnative(GetItemBallIdAndAmountFromTemplate)
	finditem(VAR_RESULT, VAR_0x8009)
}

script Common_EventScript_FindItemAsh {
    if (!flag(FLAG_CAN_DIG_PILE)) {
        msgbox("It looks like there might be something\nburied here...", MSGBOX_AUTOCLOSE)
        end
    }

    getobjectxy(VAR_LAST_TALKED, CURRENT_POSITION, VAR_TEMP_1, VAR_TEMP_2)
    setmetatile(VAR_TEMP_1, VAR_TEMP_2, METATILE_Fallarbor_AshField, FALSE)
    special(DrawWholeMapView)
    applymovement(VAR_LAST_TALKED, moves(set_visible jump_in_place_down delay_8))
    waitmovement(0)
    callnative(GetItemBallIdAndAmountFromTemplate)
	finditem(VAR_RESULT, VAR_0x8009)
}

//MARK: Shrub
script EventScript_ClosedShrubDoor {
    msgbox("It's a large shrub.\nIt looks big enough to fit inside.", MSGBOX_DEFAULT)
    if (flag(FLAG_CAN_OPEN_SHRUB)) {
        msgbox("Do you want to pry it open?", MSGBOX_YESNO)
        if (var(VAR_RESULT) == YES) {
            closemessage
            playse(SE_SUDOWOODO_SHAKE)
            waitse
            playse(SE_BREAKABLE_DOOR)
            applymovement(LOCALID_PLAYER, moves(delay_16))
            waitmovement
            getobjectxy(LOCALID_PLAYER, CURRENT_POSITION, VAR_TEMP_1, VAR_TEMP_2)
            subvar(VAR_TEMP_2, 1)
            setmetatile(VAR_TEMP_1, VAR_TEMP_2, METATILE_Fortree_SecretBase_ShrubOpen, FALSE)
            special(DrawWholeMapView)
            waitse
            msgbox("The shrub was opened!", MSGBOX_AUTOCLOSE)
        }
    }
    releaseall
}

script EventScript_BigShrub {
    msgbox("It's a large shrub.", MSGBOX_SIGN)
}


//MARK: Pokemart
script Generic_POKEMART {
    lock
    faceplayer
    message("Welcome!\pHow may I serve you?")
    waitmessage
    call(Generic_GetBadgeCount)
    switch(var(VAR_RESULT)) {
        case 0:
            pokemart(GenericPokeMart_1)
            break

        case 1:
            pokemart(GenericPokeMart_2)
            break
        
        case 2:
            pokemart(GenericPokeMart_3)
            break

        case 3:
            pokemart(GenericPokeMart_4)
            break

        case 4:
        case 5:
        case 6:
        case 7:
        case 8:
        default:
            pokemart(GenericPokeMart_5)
    }
    msgbox("Please come again!", MSGBOX_DEFAULT)
    release
}

