//MARK: Pokemart 2
script Generic_POKEMART_BERRY {
    lock
    faceplayer
    message("Welcome!\pAre you interested in some berries?")
    waitmessage
    call(Generic_GetBadgeCount)
    switch(var(VAR_RESULT)) {
        case 0:
        case 1:
        case 2:
            pokemart(GenericPokeMart_Berry1)
            break
        
        case 3:
        case 4:
        case 5:
        case 6:
        case 7:
            pokemart(GenericPokeMart_Berry2)
            break

        case 8:
        default:
            pokemart(GenericPokeMart_Berry3)
            break
    }
    msgbox("Please come again!", MSGBOX_DEFAULT)
    release
}

